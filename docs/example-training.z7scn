{"fmt":1,"id":"example-training","name":"Учебный полигон","desc":"Пример сценария: чистая карта 64×64, четыре пятна ресурсов, цели «железные пластины» и «электричество». Откройте в игре: Esc → Испытания → «Открыть сценарий из файла».","author":"ЗАВОД-7","ver":1,"seed":7,"map":{"base":"blank","bounds":{"w":64,"h":64},"edits":{"terrain":[[17,-6,6,3],[18,-6,6,3],[19,-6,6,3],[20,-6,6,3],[21,-6,6,3],[22,-6,6,3],[23,-6,6,3]],"res":[[-13,-12,-12,1,1500],[-12,-15,-9,1,1500],[-11,-16,-8,1,1500],[-10,-16,-8,1,1500],[-9,-16,-8,1,1500],[-8,-17,-7,1,1500],[-7,-16,-8,1,1500],[-6,-16,-8,1,1500],[-5,-16,-8,1,1500],[-4,-15,-9,1,1500],[-3,-12,-12,1,1500],[-12,12,12,2,1200],[-11,10,14,2,1200],[-10,9,15,2,1200],[-9,9,15,2,1200],[-8,8,16,2,1200],[-7,9,15,2,1200],[-6,9,15,2,1200],[-5,10,14,2,1200],[-4,12,12,2,1200],[6,-12,-12,3,1200],[7,-14,-10,3,1200],[8,-15,-9,3,1200],[9,-15,-9,3,1200],[10,-16,-8,3,1200],[11,-15,-9,3,1200],[12,-15,-9,3,1200],[13,-14,-10,3,1200],[14,-12,-12,3,1200],[6,12,12,4,1000],[7,10,14,4,1000],[8,9,15,4,1000],[9,9,15,4,1000],[10,8,16,4,1000],[11,9,15,4,1000],[12,9,15,4,1000],[13,10,14,4,1000],[14,12,12,4,1000]],"decor":[[-20,-2,8,1],[-19,-2,8,1],[-18,-2,8,1],[-17,-2,8,1],[-16,-2,8,1],[-15,-2,8,1],[-14,-2,8,1]]},"nests":[],"ents":[],"start":{"x":0,"y":0,"w":6,"h":6}},"rules":{"enemies":"none","nests":"none","nestMin":260,"nestDens":1,"startItems":{"iron-plate":50,"stone-furnace":2,"burner-mining-drill":2,"wood":10,"coal":20},"techs":null,"preTech":[],"ban":[],"timeLimit":60},"goals":[{"k":"produce","item":"iron-plate","n":200},{"k":"build","proto":"steam-engine","n":1},{"k":"research","tech":"automation"}],"script":"game.on_tick(function (e) {\n  if (e.tick === 60 * 5) game.print('Подсказка: начните с печи и бура на железе.');\n}, 60);\n"}