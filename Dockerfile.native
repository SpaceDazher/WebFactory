FROM node:22.23.2-alpine3.22 AS build
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm ci --prefix native/rtc-runtime --ignore-scripts --no-audit --no-fund
ARG ZAVOD_INVITE_ORIGIN=""
RUN node build.mjs --min && node native/package.mjs --server-only

FROM node:22.23.2-alpine3.22
WORKDIR /app
COPY --from=build /src/dist /app/dist
ENV ZAVOD_DATA_DIR=/data \
    ZAVOD_CONTROL_BIND=0.0.0.0 \
    ZAVOD_DOCKER=1 \
    ZAVOD_CONTROL_PORT=17837 \
    ZAVOD_PLAY_PORT=17838
VOLUME ["/data"]
EXPOSE 17837 17838
EXPOSE 17900
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 CMD node -e "const n=require('node:net');const s=n.connect(17837,'127.0.0.1',()=>{s.destroy();process.exit(0)});s.on('error',()=>process.exit(1))"
CMD ["node", "/app/dist/native/server.mjs"]
