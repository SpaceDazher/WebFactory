# Proposed name: play.zavod7-game.net. Availability/ownership has NOT been established.
# Enter only the domain you have registered and pointed to this VPS.
ZAVOD_SERVER_DOMAIN=
ZAVOD_ACME_EMAIL=
# Public mode uses each installation's own key and requires no shared host token.
ZAVOD_RELAY_REGISTRATION=public
# Only for an intentionally private, single-owner deployment: openssl rand -hex 32
# Never include this operator token in a public installer or game build.
ZAVOD_RELAY_HOST_TOKEN=
